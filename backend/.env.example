# Database Configuration
# Local:      postgresql://postgres:postgres@localhost:5432/thalassemia_db
# Production: set this in Railway Dashboard → Variables (never commit real credentials)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thalassemia_db

# Model Configuration
# Path to the XGBoost model file, relative to the backend/ directory
MODEL_PATH=model/model.pkl

# Server Configuration
# Railway sets this automatically; only needed for local override
PORT=8000
RESEND_API_KEY=your_resend_api_key_here
